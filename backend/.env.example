# Server
PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bossclinician

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@bossclinician.com
ADMIN_PASSWORD=change-me

# AI microservice (FastAPI)
AI_BASE_URL=http://localhost:8000

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# SMTP (leave unset in dev to use a console-logging transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Boss Clinician <no-reply@bossclinician.com>"
NOTIFY_EMAIL=bossclinician@gmail.com

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Absolute origin members reach the site on. Every emailed link is built from
# it (verify email, password reset, magic sign-in), so a wrong value here sends
# people to a page that does not exist.
PUBLIC_SITE_URL=http://localhost:5173
