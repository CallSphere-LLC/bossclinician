# Server
PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bossclinician

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@bossclinician.com
ADMIN_PASSWORD=change-me

# AI microservice (FastAPI)
AI_BASE_URL=http://localhost:8000

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# SMTP (leave unset in dev to use a console-logging transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Boss Clinician <no-reply@bossclinician.com>"
NOTIFY_EMAIL=bossclinician@gmail.com

# Uploads
# Two roots, and PROTECTED_UPLOAD_DIR must not sit inside UPLOAD_DIR — the
# whole of UPLOAD_DIR is served publicly at /uploads, and the backend refuses
# to boot if the paid-content directory is nested in it. In compose both are
# absolute paths on their own named volumes.
UPLOAD_DIR=uploads
PROTECTED_UPLOAD_DIR=uploads-protected
# Course video is the large case. Must stay <= nginx's client_max_body_size
# (nginx/site.conf), or nginx rejects the body and the client sees an HTML 413
# instead of the API's JSON error. Compose sets 512 in production.
MAX_UPLOAD_MB=512

# Absolute origin members reach the site on. Every emailed link is built from
# it (verify email, password reset, magic sign-in), so a wrong value here sends
# people to a page that does not exist.
PUBLIC_SITE_URL=http://localhost:5173

# Stripe. Checkout and the member billing pages answer 503 until the secret key
# is set — the app boots fine without it, it just cannot take money. The webhook
# secret comes from `stripe listen` locally, or from the dashboard endpoint in
# production; without it every webhook is rejected as unsigned, so orders are
# charged and never fulfilled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key for the browser bundle lives in ./.env at the repository root
# (docker-compose passes it as a build arg), not here.

# Amazon SES delivery reporting. Optional: without them mail still sends, only
# the delivery/bounce/complaint events stop being recorded.
SES_CONFIG_SET_TRANSACTIONAL=
SES_CONFIG_SET_MARKETING=
SES_SNS_TOPIC_ARN=

# Crawler indexing. Off everywhere except the real domain: this app serves the
# same words as the live bossclinician.com, and two indexed copies compete.
SEO_ALLOW_INDEXING=false

# The background job worker runs inside the API process (mail, Stripe follow-up,
# automations). Set false only if it is moved to its own container — nothing
# else claims jobs, so a stack with it off queues work nobody does.
WORKER_ENABLED=true
