#!/usr/bin/env python3
"""Email an alert when a Boss Clinician component goes down, and again when it recovers.

Run every minute by bossclinician-uptime-monitor.timer. A component is reported DOWN
after FAIL_THRESHOLD consecutive failing runs, reminded every REMIND_AFTER while it stays
down, and reported RECOVERED on its first passing run. Mail goes through the app's own
SES SMTP credentials, read from backend/.env at run time. A send that fails is retried
on the next run. Installed to /usr/local/sbin.

Test without touching live services (three runs send DOWN, a fourth without --fail
sends RECOVERED; a scratch --state keeps the live state untouched):
  bossclinician-uptime-monitor --state /tmp/s.json --to you+tag@example.com --fail Database
"""
import argparse
import fcntl
import json
import os
import smtplib
import socket
import ssl
import struct
import subprocess
import sys
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from email.message import EmailMessage
from email.utils import formataddr, formatdate, make_msgid

REPO = "/opt/bossclinician"
SITE = "https://bossclinician.callsphere.site"
ADMIN = "https://admin.bossclinician.callsphere.site"
ALERT_TO = "sagar@callsphere.ai"
ALERT_FROM = "uptime@bossclinician.callsphere.site"
FAIL_THRESHOLD = 3
REMIND_AFTER = 6 * 3600
TIMEOUT = 10


def env_file(path):
    out = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key, value = key.removeprefix("export ").strip(), value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            else:
                value = value.split(" #", 1)[0].strip()
            out[key] = value
    return out


def http(url, want_ok_json=False):
    request = urllib.request.Request(url, headers={"User-Agent": "bossclinician-uptime-monitor"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            body = response.read(500_000)
    except urllib.error.HTTPError as e:
        return f"HTTP {e.code} from {url}"
    except Exception as e:
        reason = getattr(e, "reason", None) or e
        return f"{reason} ({url})"
    if want_ok_json:
        try:
            if json.loads(body).get("ok") is not True:
                return f"{url} did not report ok"
        except ValueError:
            return f"{url} returned non-JSON"
    return None


def ai_service():
    try:
        svc = subprocess.run(
            ["kubectl", "-n", "bossclinician", "get", "svc", "ai", "-o", "jsonpath={.spec.clusterIP}"],
            capture_output=True, text=True, timeout=TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"K3s API unreachable ({e})"
    if svc.returncode or not svc.stdout.strip():
        return "K3s API unreachable: " + ((svc.stderr.strip().splitlines() or ["no service IP"])[-1])
    return http(f"http://{svc.stdout.strip()}:8000/health")


def video_relay():
    env = env_file(f"{REPO}/.env")
    host, port = env.get("TURN_HOST"), int(env.get("TURN_PORT") or 3478)
    if not host:
        return "TURN_HOST missing from .env"
    txid = os.urandom(12)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.settimeout(TIMEOUT)
        try:
            s.sendto(struct.pack("!HHI12s", 0x0001, 0, 0x2112A442, txid), (host, port))
            data = s.recv(2048)
        except OSError as e:
            return f"no STUN reply from {host}:{port} ({e})"
    if data[:2] != b"\x01\x01" or data[8:20] != txid:
        return f"unexpected STUN reply from {host}:{port}"
    return None


CHECKS = {
    "Website": lambda: http(f"{SITE}/"),
    "Admin panel": lambda: http(f"{ADMIN}/admin"),
    "API": lambda: http(f"{SITE}/api/health", want_ok_json=True),
    "Database": lambda: http(f"{SITE}/api/settings"),
    "AI service": ai_service,
    "Video relay": video_relay,
}


def run_check(name, forced):
    if name in forced:
        return "simulated failure (--fail)"
    error = None
    for attempt in range(2):
        try:
            error = CHECKS[name]()
        except Exception as e:
            error = f"check crashed: {e!r}"
        if error is None:
            return None
        if attempt == 0:
            time.sleep(3)
    return error


def ago(seconds):
    minutes = max(1, round(seconds / 60))
    if minutes < 60:
        return f"{minutes} min"
    hours, minutes = divmod(minutes, 60)
    if hours < 24:
        return f"{hours} h {minutes} min" if minutes else f"{hours} h"
    days, hours = divmod(hours, 24)
    return f"{days} d {hours} h" if hours else f"{days} d"


def utc(ts):
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%b %d %H:%M UTC")


def send(to, sender, subject, body):
    cfg = env_file(f"{REPO}/backend/.env")
    host, port = cfg.get("SMTP_HOST"), int(cfg.get("SMTP_PORT") or 587)
    if not host or not cfg.get("SMTP_USER") or not cfg.get("SMTP_PASS"):
        raise RuntimeError("SMTP_HOST/SMTP_USER/SMTP_PASS missing from backend/.env")
    msg = EmailMessage()
    msg["From"] = formataddr(("Boss Clinician Uptime", sender))
    msg["To"] = to
    msg["Subject"] = subject
    msg["Date"] = formatdate(localtime=False)
    msg["Message-ID"] = make_msgid(domain=sender.split("@", 1)[1])
    msg["Auto-Submitted"] = "auto-generated"
    msg.set_content(body)
    context = ssl.create_default_context()
    if port == 465:
        server = smtplib.SMTP_SSL(host, port, timeout=30, context=context)
    else:
        server = smtplib.SMTP(host, port, timeout=30)
        server.starttls(context=context)
    with server:
        server.login(cfg["SMTP_USER"], cfg["SMTP_PASS"])
        server.send_message(msg)


def compose(now, results, state, down, still_down, recovered):
    parts = []
    if down:
        parts.append("DOWN: " + ", ".join(down))
    if still_down:
        parts.append("STILL DOWN: " + ", ".join(still_down))
    if recovered:
        parts.append("RECOVERED: " + ", ".join(recovered))
    subject = "Boss Clinician " + " | ".join(parts)

    lines = [f"Boss Clinician uptime monitor on {socket.gethostname()}, {utc(now)}", ""]
    for title, names in (("DOWN", down), ("STILL DOWN", still_down)):
        if names:
            lines.append(title)
            for name in names:
                s = state[name]
                lines.append(f"  {name}: {s['error']}")
                lines.append(f"    failing since {utc(s['since'])} ({ago(now - s['since'])})")
            lines.append("")
    if recovered:
        lines.append("RECOVERED")
        for name in recovered:
            s = state[name]
            lines.append(f"  {name}: was down {ago(s['recovered_at'] - s['since'])}"
                         f" ({utc(s['since'])} to {utc(s['recovered_at'])})")
        lines.append("")
    lines.append("All components now:")
    for name, error in results.items():
        lines.append(f"  {'up  ' if error is None else 'DOWN'}  {name}" + ("" if error is None else f": {error}"))
    lines += [
        "",
        "Where to look:",
        "  sudo kubectl -n bossclinician get pods",
        "  sudo kubectl -n bossclinician logs deploy/boss-app -c backend --tail=50",
        "  docker ps -a --filter name=bossclinician-",
        "  journalctl -u bossclinician-uptime-monitor -n 30",
    ]
    return subject, "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    default_state = os.path.join(os.environ.get("STATE_DIRECTORY", "/var/lib/bossclinician-uptime"), "state.json")
    parser.add_argument("--state", default=default_state)
    parser.add_argument("--to", default=ALERT_TO)
    parser.add_argument("--from", dest="sender", default=ALERT_FROM)
    parser.add_argument("--fail", action="append", default=[], choices=list(CHECKS),
                        help="force a check to fail, for testing")
    args = parser.parse_args()

    os.makedirs(os.path.dirname(args.state), exist_ok=True)
    lock = open(args.state + ".lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        with open(args.state) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}

    with ThreadPoolExecutor(max_workers=len(CHECKS)) as pool:
        futures = {name: pool.submit(run_check, name, set(args.fail)) for name in CHECKS}
    results = {name: future.result() for name, future in futures.items()}

    now = time.time()
    down, still_down, recovered = [], [], []
    for name, error in results.items():
        s = state.setdefault(name, {})
        if error is None:
            if s.get("notified"):
                s.setdefault("recovered_at", now)
                recovered.append(name)
            else:
                state[name] = {}
            continue
        s.pop("recovered_at", None)
        s["fails"] = s.get("fails", 0) + 1
        s.setdefault("since", now)
        s["error"] = error
        if s["fails"] >= FAIL_THRESHOLD:
            if not s.get("notified"):
                down.append(name)
            elif now - s.get("last_notice", 0) >= REMIND_AFTER:
                still_down.append(name)
    for name in list(state):
        if name not in CHECKS:
            del state[name]

    status = ", ".join(f"{n}: {e}" for n, e in results.items() if e) or f"all {len(results)} up"
    exit_code = 0
    if down or still_down or recovered:
        subject, body = compose(now, results, state, down, still_down, recovered)
        try:
            send(args.to, args.sender, subject, body)
        except Exception as e:
            print(f"{status} | EMAIL FAILED, retrying next run: {e}", file=sys.stderr)
            exit_code = 1
        else:
            for name in down + still_down:
                state[name].update(notified=True, last_notice=now)
            for name in recovered:
                state[name] = {}
            status += f" | emailed {args.to}: {subject}"
    print(status)

    tmp = args.state + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=1)
    os.replace(tmp, args.state)
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
