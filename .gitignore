# deps
node_modules/
**/node_modules/
.venv/
__pycache__/
*.pyc

# builds
dist/
build/
frontend/dist/
backend/dist/

# env / secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# scrape raw (keep images in frontend/public; raw html is bulky source material)
_scrape/pages/*.html
_scrape/.venv/

# misc
.DS_Store
*.log
backups/

# build artifacts / local dev output
frontend/dist-dev/
backend/tsconfig.tsbuildinfo
*.tsbuildinfo

# stray downloads (receipts, invoices) — not source
/2026-*-*.pdf

# Cloud sign-in details the owner pastes in; never commit these.
*credentials*.txt
*accessKeys*.csv
